{
  "name": "fritzbox-cloudflare-dyndns-vercel",
  "type": "module",
  "version": "2.8.3",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "author": "piscis",
  "license": "MIT",
  "homepage": "https://github.com/piscis/fritzbox-cloudflare-dyndns-vercel",
  "repository": "https://github.com/piscis/fritzbox-cloudflare-dyndns-vercel.git",
  "engines": {
    "node": ">=24.11.0"
  },
  "issues": "https://github.com/piscis/fritzbox-cloudflare-dyndns-vercel/issues",
  "scripts": {
    "start": "node .output/server/index.mjs",
    "release:patch": "release-it -i patch --only-version",
    "release:minor": "release-it -i minor --only-version",
    "release:major": "release-it -i major --only-version",
    "clean": "rimraf node_modules .nuxt .output dist .vercel .wrangler coverage",
    "build": "nuxt build",
    "build:cf": "NITRO_PRESET=cloudflare_module phase run nuxt build",
    "deploy:cf": "phase run \"pnpm exec wrangler --cwd .output deploy\"",
    "dev": "phase run nuxt dev",
    "typecheck": "nuxt typecheck",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "analyze": "nuxi analyze",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.126",
    "@nuxt/ui": "^4.11.0",
    "@orpc/openapi": "^1.15.0",
    "@orpc/server": "^1.15.0",
    "@orpc/zod": "^1.15.0",
    "cloudflare": "^7.1.0",
    "consola": "^3.4.2",
    "nuxt": "^4.5.2",
    "radash": "^12.1.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.2.0",
    "@release-it/conventional-changelog": "^12.0.0",
    "@vitest/coverage-v8": "4.1.11",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^10.9.1",
    "h3": "^1.15.11",
    "happy-dom": "^20.11.12",
    "node-mock-http": "^1.0.5",
    "release-it": "^21.0.2",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.127.0"
  }
}
